{
  "name": "fath-kliknclean-qa-assignment",
  "version": "1.0.0",
  "description": "Senior QA Engineer Take-Home Assessment solution for KliknClean featuring Cypress UI & API test framework and QA Strategy documentation.",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:ui": "cypress run --spec 'cypress/e2e/ui/**/*.cy.ts'",
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.ts'",
    "test:headed": "cypress run --headed",
    "test:open": "cypress open",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox"
  },
  "keywords": [
    "cypress",
    "typescript",
    "qa-automation",
    "e2e-testing",
    "api-testing",
    "kliknclean",
    "saucedemo",
    "fakestoreapi"
  ],
  "author": "Fath Akbar Rahmad Baskara",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^13.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.22.0"
  }
}
